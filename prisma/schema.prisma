// ProCare schema — implements TDD.md §5 (spec-002-v1).
// Conventions:
//  - All monetary amounts are BigInt fils (ADR-002). Never Float.
//  - Financial children of Project use onDelete: Restrict — no silent cascades.
//  - Supplier.name is stored normalized (uppercased, whitespace-collapsed) by the
//    service layer; the DB @unique therefore acts as case-insensitive in practice.
//    Raw import spellings are preserved in Supplier.aliases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGEMENT
  PROCUREMENT
  COMMERCIAL
  FINANCE
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  CLOSED
}

enum Trade {
  ELECTRICAL
  PLUMBING
  HVAC
  FIRE_FIGHTING
  GENERAL
  HSE
  OTHER
}

enum LpoStatus {
  DRAFT
  ISSUED
  CLOSED
  CANCELLED
}

enum LpoKind {
  STANDARD
  VARIATION
  INTERNAL_TRANSFER
}

enum Verification {
  PENDING
  VERIFIED
  FLAGGED
}

enum PcStatus {
  DRAFT
  SUBMITTED
  CERTIFIED
  PAID
}

enum Provenance {
  SOURCE_DOCUMENT
  OCR_ESTIMATE
  CLIENT_SUMMARY
  DERIVED
  IMPORTED_REPORT
}

enum VoStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

// spec-028-v1: cost-control categories (Labour/Supervision/Admin/DLP overviews).
// spec-029: MATERIAL/OTHER extend the ledger to full project actual costs.
enum CostCategory {
  LABOUR_INHOUSE
  LABOUR_SUBCONTRACT
  SUPERVISION
  ADMIN
  DLP
  MATERIAL
  OTHER
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(VIEWER)
  active       Boolean  @default(true)
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
}

model Project {
  id                Int           @id @default(autoincrement())
  code              String        @unique
  name              String
  mainContractor    String
  contractValueFils BigInt
  vatRate           Decimal       @default(0.05) @db.Decimal(5, 4)
  status            ProjectStatus @default(ACTIVE)
  startedAt         DateTime?
  endedAt           DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  lpos              Lpo[]
  pcs               PaymentCertificate[]
  budgets           BudgetLine[]
  vos               VariationOrder[]
  retentionReleases RetentionRelease[]
  allocationsTo     LpoAllocation[]      @relation("AllocationsTo")
  costLines         CostLine[]           @relation("CostLines")
  costEntries       CostEntry[]          @relation("CostEntries")
}

// spec-022-v1 (FR-4 P1): percentage allocation of an LPO's cost to another
// project ("50% ONLY" case). Multiple rows per LPO allowed while Σpct ≤ 100
// (server-checked). Analytics consume it ADDITIVELY only.
model LpoAllocation {
  id              BigInt   @id @default(autoincrement())
  lpoId           BigInt
  lpo             Lpo      @relation(fields: [lpoId], references: [id], onDelete: Restrict)
  targetProjectId Int
  targetProject   Project  @relation("AllocationsTo", fields: [targetProjectId], references: [id], onDelete: Restrict)
  pct             Int
  note            String?
  createdAt       DateTime @default(now())

  @@unique([lpoId, targetProjectId])
  @@index([targetProjectId])
}

// spec-028-v1: generic cost-control module. Budget side (CostLine) vs actuals
// (CostEntry) per category — powers Labour / Supervision / Admin / DLP
// overviews and the monthly expenses-booked series.
model CostLine {
  id          BigInt       @id @default(autoincrement())
  projectId   Int
  project     Project      @relation("CostLines", fields: [projectId], references: [id], onDelete: Restrict)
  category    CostCategory
  amountFils  BigInt
  sourceLabel String
  note        String?
  createdAt   DateTime     @default(now())

  @@index([projectId, category])
}

model CostEntry {
  id          BigInt        @id @default(autoincrement())
  projectId   Int
  project     Project       @relation("CostEntries", fields: [projectId], references: [id], onDelete: Restrict)
  category    CostCategory
  entryDate   DateTime      @db.Date
  amountFils  BigInt
  // spec-029-v1: actuals-ledger extensions.
  kind        CostEntryKind @default(INVOICE)
  supplierId  Int?
  supplier    Supplier?     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lpoId       BigInt?
  lpo         Lpo?          @relation(fields: [lpoId], references: [id], onDelete: Restrict)
  description String?
  reference   String?
  createdAt   DateTime      @default(now())

  @@index([projectId, category, entryDate])
  @@index([supplierId])
  @@index([lpoId])
}

enum CostEntryKind {
  INVOICE
  PAYMENT
}

model Supplier {
  id           Int        @id @default(autoincrement())
  name         String     @unique
  aliases      Json       @default("[]")
  mergedIntoId Int?
  mergedInto   Supplier?  @relation("SupplierMerges", fields: [mergedIntoId], references: [id])
  merges       Supplier[] @relation("SupplierMerges")
  createdAt    DateTime   @default(now())

  lpos        Lpo[]
  costEntries CostEntry[]
}

model Lpo {
  id             BigInt          @id @default(autoincrement())
  projectId      Int
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  refNo          String
  seq            Int
  revisionOfId   BigInt?
  revisionOf     Lpo?            @relation("LpoRevisions", fields: [revisionOfId], references: [id], onDelete: Restrict)
  revisions      Lpo[]           @relation("LpoRevisions")
  revisionNo     Int             @default(0)
  supersededById BigInt?         @unique
  supersededBy   Lpo?            @relation("LpoSupersede", fields: [supersededById], references: [id], onDelete: Restrict)
  supersedes     Lpo[]           @relation("LpoSupersede")
  supplierId     Int
  costEntries    CostEntry[]
  supplier       Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  trade          Trade
  description    String
  issueDate      DateTime        @db.Date
  indentDate     DateTime?       @db.Date
  deliveryDate   DateTime?       @db.Date
  amountFils     BigInt
  vatRate        Decimal         @db.Decimal(5, 4)
  kind           LpoKind         @default(STANDARD)
  status         LpoStatus       @default(DRAFT)
  verification   Verification    @default(PENDING)
  provenance     Provenance      @default(SOURCE_DOCUMENT)
  remark         String?
  voId           BigInt?
  vo             VariationOrder? @relation(fields: [voId], references: [id], onDelete: Restrict)
  allocations    LpoAllocation[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([projectId, refNo])
  @@unique([projectId, seq])
  @@index([projectId, issueDate])
  @@index([supplierId])
}

model BudgetLine {
  id          BigInt    @id @default(autoincrement())
  projectId   Int
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  trade       Trade
  category    String    @default("MATERIALS")
  amountFils  BigInt
  sourceLabel String
  refDate     DateTime?
  note        String?
  createdAt   DateTime  @default(now())

  @@index([projectId, trade])
}

model PaymentCertificate {
  id                   BigInt     @id @default(autoincrement())
  projectId            Int
  project              Project    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  pcNumber             Int
  periodLabel          String
  periodStart          DateTime?
  periodEnd            DateTime?
  invoiceDate          DateTime?
  applicationDate      DateTime?
  dueDate              DateTime?
  paymentReceivedDate  DateTime?
  grossFils            BigInt
  retentionFils        BigInt
  netPayableFils       BigInt
  variationClaimFils   BigInt     @default(0)
  statedCumulativeFils BigInt?
  status               PcStatus   @default(DRAFT)
  provenance           Provenance
  notes                String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  retentionReleases RetentionRelease[]

  @@unique([projectId, pcNumber])
  @@index([projectId])
}

// spec-019-v1 (FR-6 P1 / OQ-7): retention money returned by the client.
// Optional pcId lets a release aggregate across certificates. Financial
// record: immutable-on-edit — no UPDATE path; mistakes are deleted by ADMIN
// (audited) or offset with a new entry.
model RetentionRelease {
  id         BigInt              @id @default(autoincrement())
  projectId  Int
  project    Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  pcId       BigInt?
  pc         PaymentCertificate? @relation(fields: [pcId], references: [id], onDelete: Restrict)
  amountFils BigInt
  releasedAt DateTime
  reference  String?
  note       String?
  createdAt  DateTime            @default(now())

  @@index([projectId, releasedAt])
  @@index([pcId])
}

model VariationOrder {
  id                 BigInt    @id @default(autoincrement())
  projectId          Int
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  voNumber           Int
  title              String
  status             VoStatus  @default(DRAFT)
  submittedValueFils BigInt
  approvedValueFils  BigInt?
  approvedAt         DateTime?
  approvalRef        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  lpos Lpo[]

  @@unique([projectId, voNumber])
}

model AuditLog {
  id       BigInt   @id @default(autoincrement())
  actorId  Int
  entity   String
  entityId String
  action   String
  before   Json?
  after    Json?
  at       DateTime @default(now())

  @@index([entity, entityId])
  @@index([at])
}

model DataFlag {
  id             BigInt    @id @default(autoincrement())
  entityType     String
  entityId       String
  ruleCode       String
  severity       String
  message        String
  status         String    @default("OPEN")
  assigneeId     Int?
  resolutionNote String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([status])
}
