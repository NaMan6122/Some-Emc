# Copy to .env and fill real values. Never commit .env (instruction_v4.md §9).
#
# Local dev (docker-compose):
DATABASE_URL="postgresql://procare:procare@localhost:5433/procare?schema=public"
AUTH_SECRET="generate-a-long-random-secret-here"

# Hosted Postgres (e.g. Neon) — use the POOLED url, SSL enforced:
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
